<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Training record — <%= u.name %></title>
<style>
body{font:13px/1.45 system-ui,"Segoe UI",sans-serif;color:#0f172a;background:#f1f5f9;margin:0}
.doc-page{max-width:900px;margin:20px auto;background:#fff;padding:36px}
h1{font-size:20px;margin:0}h2{font-size:14px;margin:22px 0 8px;text-transform:uppercase;letter-spacing:.05em;color:#334155;border-bottom:2px solid #0f172a;padding-bottom:4px}
table{border-collapse:collapse;width:100%}th,td{border:1px solid #cbd5e1;padding:5px 7px;text-align:left;vertical-align:top}th{background:#f8fafc;font-size:11px}
.head{display:flex;justify-content:space-between;align-items:center;gap:16px}.muted{color:#64748b}.noprint{margin-bottom:12px}
@media print{body{background:#fff}.doc-page{margin:0;padding:0}.noprint{display:none}}
</style></head><body>
<div class="doc-page">
  <div class="noprint"><button onclick="print()">Print / Save as PDF</button></div>
  <div class="head">
    <div><h1><%= rpto.name %></h1><div class="muted"><%= rpto.address || rpto.city %><%= rpto.auth_no ? ' · Authorisation ' + rpto.auth_no : '' %></div></div>
    <% if (rpto.logo) { %><img src="/files/<%= rpto.logo %>" alt="" style="max-height:60px"><% } %>
  </div>
  <h2>Trainee</h2>
  <table>
    <tr><th>Name</th><td><%= u.name %></td><th>Roll no.</th><td><%= a.roll_no || '—' %></td></tr>
    <tr><th>Email</th><td><%= u.email %></td><th>Mobile</th><td><%= u.phone || '—' %></td></tr>
    <tr><th>Date of birth</th><td><%= u.dob || '—' %></td><th>Father / guardian</th><td><%= u.father_name || '—' %></td></tr>
    <tr><th>Address</th><td colspan="3"><%= u.address || '—' %></td></tr>
  </table>
  <h2>Course</h2>
  <table>
    <tr><th>Batch</th><td><%= batch.title %></td><th>Certificate</th><td><%= batch.certificate %></td></tr>
    <tr><th>RPAS category / class</th><td><%= batch.rpas_category %> / <%= batch.rpas_class %></td><th>Delivery</th><td><%= batch.delivery %></td></tr>
    <tr><th>Dates</th><td><%= batch.start_date || '—' %> to <%= batch.end_date || '—' %></td><th>Status</th><td><%= a.status %></td></tr>
    <tr><th>Course certificate</th><td><%= a.cert_no || '—' %></td><th>RPC</th><td><%= a.rpc_no || '—' %><%= a.rpc_issued_at ? ' (' + a.rpc_issued_at + ')' : '' %></td></tr>
  </table>
  <h2>Documents</h2>
  <table><tr><th>Document</th><th>Status</th><th>Uploaded</th></tr>
    <% Object.entries(L.TRAINEE_DOCS).forEach(([k, label]) => { const d = docs.find(x => x.doc_type === k); %><tr><td><%= label %></td><td><%= d ? d.status : 'missing' %></td><td><%= d ? String(d.uploaded_at).slice(0, 10) : '—' %></td></tr><% }) %>
  </table>
  <h2>Training sessions & attendance</h2>
  <table><tr><th>Date</th><th>Time</th><th>Type</th><th>Session</th><th>Instructor</th><th>Attendance</th><th>Assessment</th></tr>
    <% sessions.forEach(s => { %><tr><td><%= s.date %></td><td><%= String(s.start_time || '').slice(0, 5) %>–<%= String(s.end_time || '').slice(0, 5) %></td><td><%= s.type %></td><td><%= s.title %></td><td><%= s.instructor || '—' %></td>
      <td><%= s.present === null ? (s.status === 'done' ? 'Not marked' : 'Scheduled') : s.present ? 'Present' : 'Absent' %></td><td><%= s.assessment ? s.assessment.replace('_', ' ') : '—' %></td></tr><% }) %>
  </table>
  <h2>Tests</h2>
  <table><tr><th>Test</th><th>Type</th><th>Score</th><th>Result</th><th>Date</th><th>Remarks</th></tr>
    <% results.forEach(r => { %><tr><td><%= r.title %></td><td><%= r.type %></td><td><%= r.score !== null && r.score !== undefined ? r.score + ' / ' + r.total : '—' %></td><td><%= r.passed === null || r.passed === undefined ? 'Pending' : r.passed ? 'Pass' : 'Fail' %></td><td><%= r.taken_at ? String(r.taken_at).slice(0, 10) : '—' %></td><td><%= r.remarks || '' %></td></tr><% }) %>
  </table>
  <h2>Flight log (<%= flights.length %> flights · <%= mins(flights.reduce((t, f) => t + f.minutes, 0)) %>)</h2>
  <table><tr><th>Date</th><th>Time</th><th>Activity</th><th>RPAS (UIN)</th><th>Battery</th><th>Place</th><th>Minutes</th><th>Instructor</th></tr>
    <% flights.forEach(f => { %><tr><td><%= f.date %></td><td><%= String(f.time || '').slice(0, 5) %></td><td><%= f.activity %></td><td><%= f.rpas || '—' %><%= f.uin ? ' (' + f.uin + ')' : '' %></td><td><%= f.battery || '—' %></td><td><%= f.place || '—' %></td><td><%= f.minutes %></td><td><%= f.instructor || '—' %></td></tr><% }) %>
  </table>
  <p class="muted" style="margin-top:28px">Generated <%= new Date().toLocaleString('en-IN') %> by <%= appName %>.</p>
</div>
</body></html>
