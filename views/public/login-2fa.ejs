<%- include('../partials/site', { title: 'Two-step verification' }) %>
<div class="auth">
  <div class="card">
    <h1>Two-step verification</h1>
    <p class="muted">Enter the 6-digit code from your authenticator app. Lost your phone? Enter one of your recovery codes instead.</p>
    <% if (error) { %><div class="alert bad"><%= error %></div><% } %>
    <form method="post" action="/login/2fa<%= query.next ? '?next=' + encodeURIComponent(query.next) : '' %>">
      <div class="field"><label>Code</label><input name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus maxlength="11" placeholder="123456"></div>
      <button class="btn pri" style="width:100%;justify-content:center">Verify</button>
    </form>
    <p class="small muted mt"><a href="/login">Back to log in</a></p>
  </div>
</div>
<%- include('../partials/site-end') %>
