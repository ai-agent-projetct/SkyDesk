<%- include('../partials/site', { title: 'Drone pilot training & logbooks', bodyClass: 'home3d',
  extraHead: `<link rel="stylesheet" href="/static/home.css?v=${v}"><script type="importmap">{"imports":{"three":"/vendor/three/three.module.js","drone3d":"/static/drone3d.js?v=${v}"}}</script>` }) %>
<%# Scroll-driven 3D homepage. Spec: docs/3d-homepage-prompt.md. The drone's poses come from the data-drone / data-drone-at markers below. %>
<div class="sky sky-day" aria-hidden="true"></div>
<div class="sky sky-night" aria-hidden="true"></div>
<div class="sky sky-replay" aria-hidden="true"></div>
<canvas id="scene3d" aria-hidden="true"></canvas>

<main id="top">
  <!-- 1. Hero -->
  <section class="h-hero">
    <div class="clouds" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <span class="badge">● For DGCA-authorised RPTOs and their pilots</span>
    <h1>Train pilots. Log every flight.<br><em>One sky, one platform.</em></h1>
    <p class="lead">Admissions, batches, tests and certificates for drone schools — logbooks, 3D flight replays and a practice simulator for every pilot they train.</p>
    <div class="cta">
      <a class="btn pri lg" href="/register-rpto">Register your RPTO →</a>
      <a class="btn glass lg" href="/register">I'm a pilot</a>
    </div>
    <div class="drone-spot" data-drone-at="1,-25,0"></div>
    <div class="stats">
      <div><b><%= stats.rptos %></b><span>RPTOs onboarded</span></div>
      <div><b><%= stats.students %></b><span>Pilots training</span></div>
      <div><b><%= stats.certs %></b><span>Certificates issued</span></div>
    </div>
    <svg class="ribbon" viewBox="0 0 400 600" preserveAspectRatio="none" aria-hidden="true"><path d="M380 0 C 250 160, 420 300, 180 420 S 40 560, 0 600" /></svg>
  </section>

  <!-- 2. 3D replay (pinned stage) -->
  <section id="replay" class="h-replay" data-replay>
    <div class="stage">
      <div class="stage-copy">
        <span class="eyebrow">● 3D flight replay</span>
        <h2>Relive any flight from five camera angles.</h2>
        <p>Upload an ArduPilot <b>.bin</b> or <b>.log</b>, a PX4 <b>.ulg</b> or a CSV export. AERON rebuilds it in 3D, with graphs, flight-health checks, PID tuning hints and a printable report.</p>
        <div class="chips"><span>ArduPilot (.bin / .log)</span><span>PX4 (.ulg)</span><span>CSV / DJI exports</span></div>
      </div>
      <div class="hud" aria-hidden="true">
        <div class="hud-top"><span class="rec">● REC</span> <span id="hudMode">FPV</span> · <span id="hudTime">T+00:00</span></div>
        <div class="hud-hdg" id="hudHdg">000</div>
        <div class="hud-l"><small>SPD km/h</small><b id="hudSpd">0</b><small id="hudThr">THR 0%</small></div>
        <div class="hud-r"><small>ALT m</small><b id="hudAlt">0</b><small id="hudVs">V/S 0.0</small></div>
        <div class="hud-bot"><span id="hudBat">BATT 100%</span><span>SATS 14</span><span id="hudPos">13.0827 N · 80.2707 E</span><span class="ok">● LINK OK</span></div>
        <div class="hud-cross"></div>
      </div>
      <div class="captions">
        <% [['Follow', 'Behind and above — the aircraft and where it is heading, always in frame.'],
            ['Chase', 'Low and close, like a camera car tracking the flight.'],
            ['Top', 'Straight down: the whole route, and how tight each turn really was.'],
            ['Side', 'In profile: climbs, descents and how steady the height hold was.'],
            ['FPV', "The pilot's eye, with speed, height and battery on screen."]].forEach(([k, t], i) => { %>
          <div class="cap" data-cap="<%= i %>"><b>0<%= i + 1 %></b> <strong><%= k %></strong><p><%= t %></p></div>
        <% }) %>
      </div>
      <div class="pills"><% ['Follow', 'Chase', 'Top', 'Side', 'FPV'].forEach((k, i) => { %><span data-pill="<%= i %>"><%= k %></span><% }) %></div>
      <noscript><p class="stage-fallback">Camera views: Follow, Chase, Top, Side and FPV.</p></noscript>
    </div>
  </section>

  <!-- 3. Pilot dashboard (sample data, illustrative) -->
  <section id="pilots" class="h-sec">
    <span class="eyebrow">● Pilot dashboard</span>
    <h2>Every hour you've flown, on one screen.</h2>
    <p class="sub">Training flights from your school, the logs you upload and your manual entries roll up into one live dashboard — hours, currency, fleet and what's coming up next.</p>
    <% const months = [['Oct', 62], ['Nov', 71], ['Dec', 58], ['Jan', 80], ['Feb', 76], ['Mar', 94], ['Apr', 88], ['May', 102], ['Jun', 91], ['Jul', 110], ['Aug', 118], ['Sep', 126]], top = 126;
       const upcoming = [['03', 'Oct', 'Crop spray — Paddy block 7', 'Hexacopter · 35 min · Agriculture', 'Confirmed', 'ok'],
         ['05', 'Oct', 'Bridge inspection — River span 2', 'Quad · 24 min · Thermal', 'Standby', 'wait'],
         ['07', 'Oct', 'Check ride with instructor', 'Trainer quad · 40 min · Training', 'Assigned', 'set'],
         ['09', 'Oct', 'Corridor survey — Ring road phase 3', 'VTOL · 55 min · Mapping', 'Assigned', 'set']];
       const mix = [['Mapping', 38, '#0d5ef1'], ['Inspection', 27, '#5b9dff'], ['Agriculture', 21, '#152a97'], ['Training', 14, '#94a3b8']]; %>
    <div class="dash">
      <div class="dash-head"><div><b>Arjun N.</b><span>Remote pilot · RPC valid to Mar 2031</span></div><div class="dash-tabs"><span class="on">12 months</span><span>This year</span><span>All time</span></div></div>
      <div class="dash-kpis">
        <div><span>Flight hours</span><b>1,146</b><em class="up">▲ 12% vs last year</em></div>
        <div><span>Flights</span><b>2,874</b><em>avg 24 min each</em></div>
        <div><span>Aircraft types</span><b>06</b><em>quad · hexa · VTOL</em></div>
        <div><span>Currency</span><b class="ok">98%</b><em>current on 5 of 6 types</em></div>
      </div>
      <div class="dash-grid">
        <div class="dash-card">
          <div class="dash-t">Flight hours by month <span class="up">+7% this month</span></div>
          <div class="dash-bars" data-drone-at="0.46,-30,0.22"><% months.forEach(([m, h], i) => { %><div><i style="height:<%= Math.round(h / top * 100) %>%" class="<%= i === months.length - 1 ? 'now' : '' %>" title="<%= m %>: <%= h %> h"></i><small><%= m %></small></div><% }) %></div>
          <div class="dash-t mt2">Flight mix</div>
          <div class="mixbar"><% mix.forEach(([k, pct, c]) => { %><i style="width:<%= pct %>%;background:<%= c %>" title="<%= k %> <%= pct %>%"></i><% }) %></div>
          <div class="mixlegend"><% mix.forEach(([k, pct, c]) => { %><span><i style="background:<%= c %>"></i><%= k %> <b><%= pct %>%</b></span><% }) %></div>
        </div>
        <div class="dash-card">
          <div class="dash-t">Upcoming flights <span>next assignments</span></div>
          <% upcoming.forEach(([d, m, title, meta, status, cls]) => { %>
          <div class="up-row"><div class="up-date"><b><%= d %></b><small><%= m %></small></div><div class="grow"><b><%= title %></b><small><%= meta %></small></div><span class="chip <%= cls %>"><%= status %></span></div>
          <% }) %>
        </div>
      </div>
    </div>
    <ul class="hub-list">
      <li><b>Licence & currency reminders.</b> A heads-up before your licence expires or you fall out of recent practice.</li>
      <li><b>Your own fleet.</b> Hours per drone, cycles per battery, and a nudge before maintenance is due.</li>
      <li><b>Add to logbook from the replay.</b> Pick the drone, battery and exercise once; the log fills in the rest.</li>
      <li><b>Live monitor.</b> Watch telemetry from your ground station on any screen and save the flight. Read-only by design.</li>
      <li><b>Tutorials.</b> Short guides from the platform team, with questions and answers underneath.</li>
      <li><b>Print or export.</b> Any logbook as a PDF or an Excel sheet, whenever an inspector asks.</li>
    </ul>
  </section>

  <!-- 4b. Automated compliance: the same four logbooks shown blank ("By hand") or filled from the flight data ("Automated") -->
  <section id="logbooks" class="h-sec night lbx" data-sky="night">
    <span class="eyebrow">● Automated compliance</span>
    <h2>Four logbooks that fill themselves.</h2>
    <p class="sub">A pilot logbook, a flight log for every drone, a battery log and a maintenance log — kept by hand, that is a stack of forms after every flight.
      AERON writes all four from the flight logs you upload and the sessions your school signs off, so nobody retypes a thing.</p>
    <div class="lb-row">
      <div class="lb-toggle" role="group" aria-label="Show logbooks kept by hand or automatically">
        <button type="button" data-lb="manual" aria-pressed="false">By hand ✕</button>
        <button type="button" data-lb="auto" aria-pressed="true">Automated ✓</button>
      </div>
      <span class="lb-drone" data-drone-at="0.34,25,0"></span>
    </div>
    <% const books = [
      ['🧑‍✈️', 'Pilot logbook', 'Your hours, currency and licence, always current.', [['Total flight time', '42h 10m'], ['Last 90 days', '3 flights · current'], ['Licence valid to', '12 Mar 2031']]],
      ['🛸', 'Flight logbook', 'Every flight of every drone, logged on landing.', [['Date & take-off', '10 Sep · 06:42'], ['Distance · max height', '3.1 km · 58 m'], ['Aircraft · UIN', 'Survey quad · UA-0142']]],
      ['🔋', 'Battery logbook', 'Cycles and voltage for each pack, flight by flight.', [['Pack · cycles', '6S #2 · 148 / 300'], ['Voltage start → end', '25.1 → 22.4 V'], ['Used this flight', '3,420 mAh']]],
      ['🛠️', 'Maintenance log', 'Airframe hours and what is due next, without a spreadsheet.', [['Airframe hours', '38h 20m'], ['Last inspection', '2 Sep · props'], ['Next due', 'in 6 flight hours']]],
    ]; %>
    <div class="cards lb-grid">
      <% books.forEach(([icon, title, line, rows]) => { %>
      <div class="card3 lb">
        <i><%= icon %></i><b><%= title %></b><p><%= line %></p>
        <dl><% rows.forEach(([k, v]) => { %><div><dt><%= k %></dt><dd><span><%= v %></span></dd></div><% }) %></dl>
        <div class="lb-foot"><span class="a">✓ Filled from the flight log</span><span class="m">✎ Typed in after every flight</span></div>
      </div>
      <% }) %>
    </div>
    <p class="lb-sum" aria-live="polite"><span class="a"><b>0</b> fields typed — all four logbooks up to date.</span><span class="m"><b>12</b> fields to fill in after every flight, and four books to keep in step.</span></p>
  </section>

  <!-- 5. Simulator -->
  <section id="simulator" class="h-sec night centered" data-sky="night">
    <span class="eyebrow">● Practice simulator</span>
    <h2>Practise before you fly — right in the browser</h2>
    <p class="sub">Keyboard or a USB transmitter. Real flight-mode behaviour, drills that score themselves, and a coach that talks you through it.</p>
    <figure class="sim-demo">
      <video muted loop playsinline preload="none" poster="/static/media/sim-demo.jpg" aria-label="Demo: a trainee drone arms on the helipad, flies a figure-8 through the course with voice coaching, and lands">
        <source src="/static/media/sim-demo.mp4" type="video/mp4">
      </video>
      <figcaption>One lap of the figure-8 drill — altitude, speed, flight mode, coaching and your sticks on screen. <a href="/simulator">Fly it yourself →</a></figcaption>
    </figure>
    <div class="cards c3">
      <div class="card3"><i>🧭</i><b>Real flight modes</b><p>Loiter holds position, AltHold holds only height, Stabilize holds nothing — feel the difference safely.</p></div>
      <div class="card3"><i>🔋</i><b>Arming & failsafes</b><p>Arm with the stick gesture, take off, return home — and a low battery brings you back on its own.</p></div>
      <div class="card3"><i>🎯</i><b>Scored drills</b><p>Hover and land, square, figure-8, an agri spray field with coverage, and an FPV gate course.</p></div>
      <div class="card3" data-drone="-0.55,0.1,0.3,-40"><i>👀</i><b>Watch, then fly</b><p>An autopilot flies each drill first. Replay your own attempt afterwards with the flight path drawn in.</p></div>
      <div class="card3"><i>🗣️</i><b>Voice coaching</b><p>Spoken prompts in English and ten Indian languages, from Hindi and Tamil to Odia and Punjabi.</p></div>
      <div class="card3"><i>🛸</i><b>Fly like your drone</b><p>Pick a profile built from your own uploaded flights, so practice matches the aircraft you actually fly.</p></div>
    </div>
  </section>

  <!-- 4. For RPTOs (after the pilot story) -->
  <section id="rpto" class="h-sec">
    <span class="eyebrow">● For RPTOs</span>
    <h2>Everything your training school runs on</h2>
    <p class="sub">From the first enquiry to the RPC number — every step hands off to the next, so a trainee's record is complete the day they finish.</p>
    <div class="cards c4">
      <div class="card3"><i>📝</i><b>Admissions & documents</b><p>Enquiries, applications, consent, document checks and the 18–65 rule before a seat and roll number are confirmed.</p></div>
      <div class="card3"><i>🗓️</i><b>Auto-scheduled batches</b><p>One click builds ground classes, per-trainee simulator and flying slots and tests — then drag them on a timeline.</p></div>
      <div class="card3"><i>📈</i><b>Per-trainee progress</b><p>Mark classes done, slide each trainee's flying progress and drop their flight logs straight onto the slot.</p></div>
      <div class="card3"><i>✅</i><b>Tests your way</b><p>Online theory from your bank, the browser simulator test, practical marking with evidence, or printed OMR sheets.</p></div>
      <div class="card3"><i>🎓</i><b>Certificates & RPC</b><p>Signed by the RPA trainer, numbered automatically, with a ZIP record package ready for submission.</p></div>
      <div class="card3"><i>💳</i><b>CRM & fees</b><p>Lead pipeline and follow-ups, course fees with GST, part payments and numbered receipts.</p></div>
      <div class="card3"><i>🛠️</i><b>Assets & logbooks</b><p>RPAS, batteries, chargers, simulators and fields — flight, battery, maintenance and incident logbooks.</p></div>
      <div class="card3"><i>👥</i><b>Staff & roles</b><p>Accountable Manager, Admin, Instructor and Sales, each seeing exactly what their role needs.</p></div>
    </div>
    <div class="perch" data-drone-at="0.42,35,0.2"></div>
  </section>

  <!-- 6. Pricing -->
  <section id="pricing" class="h-sec">
    <span class="eyebrow">● Pricing</span>
    <h2>Free to start. Pay as you grow.</h2>
    <div class="cards c3 plans">
      <div class="card3 plan"><b>Pilot</b><div class="price">₹0<small> forever</small></div>
        <ul><li>Pilot logbooks & fleet</li><li>3D replay, graphs & health checks</li><li>Practice simulator</li><li>Up to <%= price.free %> flight uploads</li></ul>
        <a class="btn" href="/register">Create free account</a></div>
      <div class="card3 plan hot"><b>Pilot Pro</b> <span class="tag">Most flights</span><div class="price">₹<%= price.month.toLocaleString('en-IN') %><small> / month</small></div>
        <ul><li>Everything in Pilot</li><li>Unlimited flight uploads</li><li>₹<%= price.year.toLocaleString('en-IN') %> a year — two months free</li><li>Certificates free at partner RPTOs</li></ul>
        <a class="btn pri" href="/register">Go Pro</a>
        <div class="plan-spot" data-drone-at="0.4,-20,0.12"></div></div>
      <div class="card3 plan"><b>RPTO</b><div class="price"><%= price.credit ? '₹' + price.credit.toLocaleString('en-IN') : 'Free' %><small><%= price.credit ? ' / certificate' : ' to issue' %></small></div>
        <ul><li>Unlimited batches and trainees</li><li>Up to 30 staff logins</li><li>Scheduling, tests, certificates & records</li><li>CRM, fees and GST receipts</li></ul>
        <a class="btn" href="/register-rpto">Register your RPTO</a></div>
    </div>
    <p class="note">Prices include GST. RPTOs pay only when they issue a certificate.</p>
  </section>

  <!-- 7. Portals -->
  <section id="portals" class="h-sec">
    <span class="eyebrow">● Portals</span>
    <h2>One sign-in, the right workspace</h2>
    <p class="sub">Everyone signs in on the same page and lands in their own workspace. New here? Pick the portal that fits you.</p>
    <div class="cards c4">
      <div class="card3 portal"><i>🛡️</i><b>Platform admin</b><p>Approve RPTOs, manage every user and payment, and keep the default syllabus and question bank.</p>
        <div class="portal-go"><a class="btn pri" href="/login">Log in</a></div></div>
      <div class="card3 portal"><i>🏫</i><b>RPTO portal</b><p>Accountable managers, admins, instructors and sales staff run their training school here.</p>
        <div class="portal-go"><a class="btn pri" href="/login">Log in</a><a class="btn" href="/register-rpto">Register RPTO</a></div></div>
      <div class="card3 portal"><i>🎓</i><b>Student portal</b><p>Trainees apply to a batch, upload documents, follow the timetable, take tests and download certificates.</p>
        <div class="portal-go"><a class="btn pri" href="/login?next=/student">Student log in</a><a class="btn" href="/register">Sign up</a></div></div>
      <div class="card3 portal"><i>🧑‍✈️</i><b>Pilot portal</b><p>Independent pilots keep their logbooks, fleet and 3D replays, and practise in the simulator.</p>
        <div class="portal-go"><a class="btn pri" href="/login?next=/pilot">Pilot log in</a><a class="btn" href="/register">Create free account</a></div></div>
    </div>
  </section>
</main>

<!-- 8. Footer with the landing pad -->
<footer class="h-foot">
  <div class="foot-grid">
    <div><b class="foot-logo"><img src="/static/aeron-mark.png" alt=""><%= appName %></b><p class="foot-tag">Robotics &amp; Drones · Engineering intelligence in motion</p><p>Training management for drone schools, and a logbook for every pilot they train.</p></div>
    <div><h4>Portals</h4><a href="/login">Log in</a><a href="/login?next=/student">Student log in</a><a href="/register-rpto">Register an RPTO</a><a href="/register">Student / pilot sign-up</a><a href="/rptos">Find an RPTO</a></div>
    <div class="pad-wrap"><div class="pad" data-drone-at="0.5,0,0,land"><span>H</span></div></div>
  </div>
  <div class="foot-base">© <%= new Date().getFullYear() %> <%= appName %></div>
</footer>
<script>
  // Automated-compliance switch: "By hand" shows the logbooks as blank forms, "Automated" as filled entries.
  document.querySelectorAll('[data-lb]').forEach(b => b.addEventListener('click', () => {
    document.getElementById('logbooks').classList.toggle('manual', b.dataset.lb === 'manual');
    document.querySelectorAll('[data-lb]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  }));
  // Simulator demo video: plays only while on screen; reduced-motion visitors get the controls instead.
  const simVid = document.querySelector('.sim-demo video');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) simVid.controls = true;
  else new IntersectionObserver(([e]) => e.isIntersecting ? simVid.play().catch(() => {}) : simVid.pause(), { threshold: .35 }).observe(simVid);
</script>
<script type="module" src="/static/home3d.js?v=<%= v %>"></script>
</body>
</html>
