<%# Drone / battery fields. Locals: a (existing asset or {}), type ('drone'|'battery') %>
<div class="fields">
  <div class="field"><label>Name *</label><input name="name" value="<%= a.name || '' %>" maxlength="150" required placeholder="<%= type === 'drone' ? 'e.g. Survey quad' : 'e.g. 6S 16000 mAh #1' %>"></div>
  <div class="field"><label>Make / model</label><input name="make" value="<%= a.make || '' %>" maxlength="150"></div>
  <div class="field"><label>Serial no.</label><input name="serial_no" value="<%= a.serial_no || '' %>" maxlength="100"></div>
  <% if (type === 'drone') { %>
    <div class="field"><label>UIN</label><input name="uin" value="<%= a.uin || '' %>" maxlength="60"></div>
    <div class="field"><label>Category</label><select name="category"><% ['', 'Rotorcraft', 'Aeroplane', 'Hybrid'].forEach(x => { %><option <%= a.category === x ? 'selected' : '' %>><%= x %></option><% }) %></select></div>
    <div class="field"><label>Class</label><select name="rpas_class"><% ['', 'Nano', 'Micro', 'Small', 'Medium', 'Large'].forEach(x => { %><option <%= a.rpas_class === x ? 'selected' : '' %>><%= x %></option><% }) %></select></div>
    <div class="field"><label><input type="checkbox" name="type_certified" value="1" <%= a.type_certified ? 'checked' : '' %>> Type certified</label></div>
  <% } else { %>
    <div class="field"><label>Capacity (mAh)</label><input type="number" name="capacity_mah" min="0" value="<%= a.capacity_mah || '' %>"></div>
    <div class="field"><label>Voltage (V)</label><input type="number" step="0.1" name="voltage" min="0" value="<%= a.voltage || '' %>"></div>
    <div class="field"><label>Cells</label><input type="number" name="cells" min="1" max="24" value="<%= a.cells || '' %>"></div>
    <div class="field"><label>Cycles before logging</label><input type="number" name="initial_cycles" min="0" value="<%= a.initial_cycles || 0 %>"></div>
    <div class="field"><label>Retire after (cycles)</label><input type="number" name="max_cycles" min="1" value="<%= a.max_cycles || 300 %>"></div>
  <% } %>
  <div class="field"><label>Acquired on</label><input type="date" name="acquired_on" value="<%= a.acquired_on || '' %>"></div>
  <div class="field"><label>Status</label><select name="status"><% ['active', 'maintenance', 'retired'].forEach(x => { %><option <%= a.status === x ? 'selected' : '' %>><%= x %></option><% }) %></select></div>
</div>
<div class="field"><label>Notes</label><input name="notes" value="<%= a.notes || '' %>" maxlength="255"></div>
