<%- include('../partials/app', { title: 'Logbooks' }) %>
<% const q = (o = {}) => '?' + new URLSearchParams({ book, ...(asset ? { asset: asset.id } : {}), ...(utc ? { utc: 1 } : {}), ...o }).toString();
   const books = [['pilot', 'Pilot logbook'], ['drone', 'Flight logbook (per drone)'], ['battery', 'Battery logbook'], ['maintenance', 'Maintenance logbook'], ['sim', 'Simulator training']]; %>
<div class="page-head">
  <div><h1><%= books.find(b => b[0] === book)[1] %></h1><div class="muted">Training flights from your RPTO, your uploaded flights and manual entries — one record, printable and exportable.</div></div>
  <div class="row noprint">
    <% if (['pilot', 'drone', 'battery'].includes(book)) { %><a class="btn" href="<%= q({ utc: utc ? '' : 1 }) %>" title="Show times in <%= utc ? 'local time' : 'UTC' %>"><%= utc ? '🕒 UTC' : '🕒 Local' %></a><% } %>
    <a class="btn" href="<%= q({ export: 1 }) %>">Export to Excel</a><button class="btn" onclick="print()">Print / PDF</button>
    <button class="btn pri" data-open="addEntry">+ Manual entry</button>
  </div>
</div>
<div class="tabs noprint"><% books.forEach(([k, l]) => { %><a href="?book=<%= k %>" class="<%= book === k ? 'on' : '' %>"><%= l %></a><% }) %></div>

<div class="card mb">
  <div class="grid g3">
    <div><div class="small muted">Pilot</div><b><%= user.name %></b><div class="small"><%= user.email %></div></div>
    <div><div class="small muted">Remote pilot licence / RPC</div><b><%= user.license_no || '—' %></b><div class="small"><%= user.regulator || 'DGCA' %><%= user.license_expiry ? ' · valid to ' + fmtDate(user.license_expiry) : '' %></div></div>
    <div><div class="small muted">Printed</div><b><%= fmtDate(today) %></b><div class="small"><%= utc ? 'Times in UTC' : 'Times in local time' %></div></div>
  </div>
</div>

<% if (book === 'pilot') { %>
<div class="grid g5 mb">
  <div class="stat info"><b><%= mins(stats.minutes) %></b><span>Total flight time</span></div>
  <div class="stat"><b><%= stats.flights %></b><span><%= stats.training %> training · <%= stats.personal %> uploaded · <%= stats.manual %> manual</span></div>
  <div class="stat <%= stats.current ? 'ok' : 'warn' %>"><b><%= stats.current ? 'Current' : 'Not current' %></b><span><%= stats.recent %> flight(s) in <%= stats.days %> days</span></div>
  <div class="stat"><b><%= stats.last ? fmtDate(stats.last) : '—' %></b><span>Last flight</span></div>
  <% if (stats.instructing) { %><div class="stat vio"><b><%= mins(stats.instructingMinutes) %></b><span>Instructing (<%= stats.instructing %>) — not in your total</span></div>
  <% } else { %><div class="stat"><b><%= stats.maxAlt.toFixed(0) %> m</b><span>Highest altitude</span></div><% } %>
</div>
<% } else if (book === 'drone' || book === 'battery') { const list = book === 'drone' ? f.drones : f.batteries; %>
<% if (!list.length) { %><div class="card empty">No <%= book === 'drone' ? 'drones' : 'batteries' %> in your fleet yet. <a href="/pilot/fleet">Add one</a>, then pick it when you log a flight.</div>
<% } else { %>
<form class="row mb noprint" method="get"><input type="hidden" name="book" value="<%= book %>"><% if (utc) { %><input type="hidden" name="utc" value="1"><% } %>
  <select name="asset" onchange="this.form.submit()" style="width:auto"><% list.forEach(a => { %><option value="<%= a.id %>" <%= asset && a.id === asset.id ? 'selected' : '' %>><%= a.name %> <%= a.uin || a.serial_no || '' %><%= a.status === 'retired' ? ' (retired)' : '' %></option><% }) %></select>
  <a class="small" href="/pilot/fleet/<%= asset.id %>">Details & maintenance →</a></form>
<div class="grid g5 mb">
  <div class="stat info"><b><%= asset.name %></b><span><%= asset.make || '' %> <%= asset.uin || asset.serial_no || '' %></span></div>
  <div class="stat"><b><%= rows.length %></b><span>Flights</span></div>
  <div class="stat"><b><%= mins(rows.reduce((s, x) => s + x.minutes, 0)) %></b><span><%= book === 'drone' ? 'Airframe time' : 'Time on this battery' %></span></div>
  <% if (book === 'battery') { %><div class="stat <%= asset.max_cycles && asset.cycles >= asset.max_cycles * .9 ? 'warn' : '' %>"><b><%= asset.cycles %><%= asset.max_cycles ? ' / ' + asset.max_cycles : '' %></b><span>Cycles<%= asset.initial_cycles ? ` (incl. ${asset.initial_cycles} before logging)` : '' %></span></div><% } %>
  <div class="stat"><b><%= asset.next_due || '—' %></b><span>Next maintenance</span></div>
</div>
<% } %>
<% } %>

<% if (['pilot', 'drone', 'battery'].includes(book) && (book === 'pilot' || asset)) { %>
<div class="tbl-wrap"><table>
  <tr><th>#</th><th>Date</th><th>Time</th><th>Type</th><th>Activity</th><% if (book !== 'drone') { %><th>Aircraft (UIN)</th><% } %><th>Place</th><th>Duration</th><th>Total</th><% if (book === 'battery') { %><th>Cycle</th><% } %><th>Max alt</th><th>Instructor / RPIC · organisation</th><th>Remarks</th><th class="noprint"></th></tr>
  <% rows.forEach((x, i) => { %>
  <tr style="<%= x.kind === 'Instructing' ? 'color:var(--muted)' : '' %>"><td><%= i + 1 %></td><td class="nowrap"><%= x.date %></td><td><%= String(x.time || '').slice(0, 5) %></td>
    <td><span class="pill <%= x.kind === 'Training' ? 'info' : x.kind === 'Instructing' ? 'vio' : '' %>"><%= x.kind %></span><% if (x.kind === 'Personal' && !x.logged) { %> <span class="pill warn" title="Add drone, battery and exercise from the replay page">review</span><% } %></td>
    <td><%= x.activity %></td><% if (book !== 'drone') { %><td class="small"><%= x.aircraft || '—' %></td><% } %><td class="small"><%= x.place || '—' %></td>
    <td class="nowrap"><%= mins(x.minutes) %></td><td class="nowrap small"><%= mins(x.cumulative) %></td><% if (book === 'battery') { %><td><%= x.cycle %></td><% } %>
    <td><%= x.maxAlt ? (+x.maxAlt).toFixed(0) + ' m' : '—' %></td><td class="small"><%= [x.instructor, x.org].filter(Boolean).join(' · ') || '—' %></td><td class="small"><%= x.remarks %></td>
    <td class="noprint nowrap"><% if (x.track) { %><a class="btn sm" href="/flights/<%= x.track %>">3D</a><% } %>
      <% if (x.entry) { %><form class="inline" method="post" action="/pilot/entries/<%= x.entry %>/delete" data-confirm="Delete this manual entry?"><button class="btn sm bad">×</button></form><% } %></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="14" class="empty">No flights here yet.</td></tr><% } %>
</table></div>
<div class="row mt" style="gap:60px"><div class="small">Pilot signature: ______________________</div><div class="small">Verified by (instructor / RPTO): ______________________</div></div>
<p class="small muted mt noprint">"Current" = at least one flight in the last <%= stats.days %> days (an internal recency check — follow your regulator's rules). Instructing time is listed for your records but not added to your own flight time.</p>

<% } else if (book === 'maintenance') { %>
<div class="tbl-wrap"><table>
  <tr><th>Date</th><th>Drone / battery</th><th>Type</th><th>Work done</th><th>Next due</th></tr>
  <% maintenance.forEach(m => { %><tr><td class="nowrap"><%= m.date %></td><td><a href="/pilot/fleet/<%= m.asset_id %>"><%= m.name %></a> <span class="small muted"><%= m.type === 'drone' ? m.uin || '' : m.serial_no || '' %></span></td>
    <td><span class="pill"><%= m.type %></span></td><td><%= m.description || '—' %></td><td><% if (m.next_due) { %><span class="pill <%= m.next_due < today ? 'bad' : 'info' %>"><%= m.next_due %></span><% } else { %>—<% } %></td></tr><% }) %>
  <% if (!maintenance.length) { %><tr><td colspan="5" class="empty">No maintenance logged. Open a drone or battery under <a href="/pilot/fleet">My fleet</a> to log work.</td></tr><% } %>
</table></div>

<% } else if (book === 'sim') { const total = sims.reduce((s, x) => s + (x.seconds || 0), 0); %>
<div class="grid g5 mb">
  <div class="stat info"><b><%= sims.length %></b><span>Simulator runs</span></div>
  <div class="stat ok"><b><%= sims.filter(s => s.passed).length %></b><span>Passed</span></div>
  <div class="stat"><b><%= mins(Math.round(total / 60)) %></b><span>Time in the simulator</span></div>
</div>
<div class="grid g2">
  <div class="card"><h2>By exercise</h2>
    <div class="tbl-wrap"><table><tr><th>Exercise</th><th>Runs</th><th>Passed</th><th>Best pass</th></tr>
      <% simBest.forEach(s => { %><tr><td><%= s.exercise %></td><td><%= s.runs %></td><td><%= +s.passed || 0 %></td><td><%= s.best != null ? s.best + ' s' : '—' %></td></tr><% }) %>
      <% if (!simBest.length) { %><tr><td colspan="4" class="empty">No runs yet. <a href="/simulator">Open the simulator</a>.</td></tr><% } %></table></div></div>
  <div class="card"><h2>Recent runs</h2>
    <div class="tbl-wrap"><table><tr><th>When</th><th>Exercise</th><th>Result</th><th>Time</th><th>Penalties</th></tr>
      <% sims.slice(0, 50).forEach(s => { %><tr><td class="nowrap small"><%= fmtDate(s.created_at) %></td><td><%= s.exercise %></td><td><span class="pill <%= s.passed ? 'pass' : 'fail' %>"><%= s.passed ? 'Pass' : 'Fail' %></span></td><td><%= s.seconds ?? '—' %> s</td><td><%= s.penalties %></td></tr><% }) %>
      <% if (!sims.length) { %><tr><td colspan="5" class="empty">No runs yet.</td></tr><% } %></table></div></div>
</div>
<% } %>

<dialog id="addEntry"><form method="post" action="/pilot/entries">
  <h2>Manual logbook entry</h2>
  <p class="small muted">For flights without a log file. Times are local.</p>
  <div class="fields">
    <div class="field"><label>Date *</label><input type="date" name="date" value="<%= today %>" max="<%= today %>" required></div>
    <div class="field"><label>Take-off</label><input type="time" name="start_time"></div>
    <div class="field"><label>Landing</label><input type="time" name="end_time"></div>
    <div class="field"><label>Minutes (if no times)</label><input type="number" name="minutes" min="0" max="1440"></div>
    <div class="field"><label>Drone</label><select name="drone_id"><option value="">—</option><% f.drones.filter(a => a.status !== 'retired').forEach(a => { %><option value="<%= a.id %>"><%= a.name %> <%= a.uin || '' %></option><% }) %></select></div>
    <div class="field"><label>Battery</label><select name="battery_id"><option value="">—</option><% f.batteries.filter(a => a.status !== 'retired').forEach(a => { %><option value="<%= a.id %>"><%= a.name %> <%= a.serial_no || '' %></option><% }) %></select></div>
    <div class="field"><label>Place</label><input name="place" maxlength="150"></div>
    <div class="field"><label>RPIC (if not you)</label><input name="rpic" maxlength="150"></div>
    <div class="field"><label>Latitude</label><input type="number" step="any" name="lat" min="-90" max="90"></div>
    <div class="field"><label>Longitude</label><input type="number" step="any" name="lon" min="-180" max="180"></div>
  </div>
  <div class="field"><label>Exercise / purpose</label><input name="exercise" maxlength="200" placeholder="e.g. Figure-8 practice, roof inspection"></div>
  <div class="field"><label>Remarks</label><input name="remarks" maxlength="255"></div>
  <div class="row"><button class="btn pri">Add entry</button><button type="button" class="btn" data-close>Cancel</button></div>
</form></dialog>
<script>if (location.hash === '#add') document.getElementById('addEntry').showModal();</script>
<%- include('../partials/end') %>
