<%- include('../partials/app', { title: 'Tutorials' }) %>
<div class="page-head"><div><h1>Tutorials</h1><div class="muted">Shown to every pilot under Pilot hub → Tutorials. YouTube and Vimeo links are embedded.</div></div>
  <button class="btn pri" data-open="tNew">+ Add tutorial</button></div>
<div class="tbl-wrap"><table>
  <tr><th>Category</th><th>Title</th><th>Video</th><th>Status</th><th>Order</th><th>Comments</th><th></th></tr>
  <% list.forEach(t => { %><tr><td><%= t.category %></td><td><a href="/pilot/tutorials/<%= t.id %>" target="_blank"><b><%= t.title %></b></a></td><td class="small"><%= t.video_url ? '▶ yes' : '—' %></td>
    <td><span class="pill <%= t.status === 'live' ? 'ok' : 'warn' %>"><%= t.status %></span></td><td><%= t.sort %></td><td><%= t.comments %></td>
    <td class="nowrap"><button class="btn sm" data-open="t<%= t.id %>">Edit</button>
      <form class="inline" method="post" action="/super/tutorials/<%= t.id %>/delete" data-confirm="Delete this tutorial and its comments?"><button class="btn sm bad">×</button></form></td></tr><% }) %>
  <% if (!list.length) { %><tr><td colspan="7" class="empty">No tutorials yet.</td></tr><% } %>
</table></div>
<div class="card mt"><h2>Latest comments</h2>
  <div class="tbl-wrap"><table><tr><th>When</th><th>Tutorial</th><th>By</th><th>Comment</th><th></th></tr>
    <% comments.forEach(c => { %><tr><td class="small nowrap"><%= fmtDate(c.created_at) %></td><td class="small"><%= c.title %></td><td><%= c.name %></td><td><%= c.body %></td>
      <td><form method="post" action="/super/comments/<%= c.id %>/delete" data-confirm="Remove this comment?"><button class="btn sm bad">Remove</button></form></td></tr><% }) %>
    <% if (!comments.length) { %><tr><td colspan="5" class="empty">No comments yet.</td></tr><% } %></table></div></div>
<% [{ id: 'tNew', action: '/super/tutorials', t: { category: 'Getting started', status: 'live', sort: 0 } }, ...list.map(t => ({ id: 't' + t.id, action: '/super/tutorials/' + t.id, t }))].forEach(({ id, action, t }) => { %>
<dialog id="<%= id %>"><form method="post" action="<%= action %>">
  <h2><%= t.id ? 'Edit tutorial' : 'Add tutorial' %></h2>
  <div class="fields">
    <div class="field"><label>Category</label><input name="category" value="<%= t.category || '' %>" maxlength="80"></div>
    <div class="field"><label>Status</label><select name="status"><option value="live" <%= t.status === 'live' ? 'selected' : '' %>>Live</option><option value="soon" <%= t.status === 'soon' ? 'selected' : '' %>>Coming soon</option></select></div>
    <div class="field"><label>Order</label><input type="number" name="sort" value="<%= t.sort || 0 %>"></div>
  </div>
  <div class="field"><label>Title *</label><input name="title" value="<%= t.title || '' %>" maxlength="200" required></div>
  <div class="field"><label>Video link (https)</label><input type="url" name="video_url" value="<%= t.video_url || '' %>" placeholder="https://www.youtube.com/watch?v=…"></div>
  <div class="field"><label>Description</label><textarea name="description" rows="5"><%= t.description || '' %></textarea></div>
  <div class="row"><button class="btn pri">Save</button><button type="button" class="btn" data-close>Cancel</button></div>
</form></dialog>
<% }) %>
<%- include('../partials/end') %>
