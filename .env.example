PORT=3000
APP_NAME=SkyDesk
# Public address of the site, used in emailed links (required for "forgot password" emails).
APP_URL=http://localhost:3000
# Long random string; signs login cookies. Change it in production.
SESSION_SECRET=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rpto_portal

# First super admin, created by `npm run setup` if it doesn't exist yet.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# Optional email (invitations, password reset, notifications). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional online payments for Pilot Pro (Razorpay). Leave empty to disable; super admin can grant Pro manually.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRO_PRICE_MONTH=349
PRO_PRICE_YEAR=3490
FREE_FLIGHT_LIMIT=25

# RPTO completion credits: ₹ per certificate for trainees without Pilot Pro. 0 = certificates are free.
CREDIT_PRICE=349
# Partner programme: % of Pilot Pro payments shared with the RPTO that certified the pilot, for PARTNER_MONTHS. 0 = off.
PARTNER_SHARE_PERCENT=10
PARTNER_MONTHS=12
